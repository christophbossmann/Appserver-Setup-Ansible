services:
  postgres-business:
    image: {{ postgres_business_image }}
    container_name: {{ postgres_business_container }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ postgres_business_port }}:5432"
    volumes:
      - {{ postgres_business_data_dir }}:/var/lib/postgresql/data
{% if postgres_pitr_enabled | default(false) %}
      - {{ (postgres_pitr_instances | selectattr('name', 'equalto', 'postgres-business') | first).host_archive }}:/archive   # PITR: WAL archive + base backups (roles/postgres_pitr; @pg_archive subvolume)
{% endif %}
    environment:
      POSTGRES_USER: {{ postgres_business_user }}
      POSTGRES_PASSWORD: {{ postgres_business_password }}
      POSTGRES_DB: {{ postgres_business_db }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_business_user }}"]
      interval: 60s
      timeout: 5s
      retries: 5

networks:
  default:
    name: backend
    external: true
