# Authentik .env — rendered by Ansible (compose_stack). Secrets from the vault
# (vault_authentik_*); non-secret config from group_vars/all/authentik.yml.
# Do NOT edit on the host — change the template/vars and re-run the playbook.

# --- Postgres (self-contained, not the shared prod-postgres) ---
PG_DB=authentik
PG_USER=authentik
PG_PASS={{ vault_authentik_postgres_password }}

# --- Core secret (session/token signing). Never change on a live install. ---
AUTHENTIK_SECRET_KEY={{ vault_authentik_secret_key }}

# --- Public URL (used for redirects and OIDC issuer) ---
AUTHENTIK_HOST={{ authentik_public_url }}

# --- Host bind port (loopback; Caddy fronts it) ---
COMPOSE_PORT_HTTP={{ authentik_http_port }}

# --- Bootstrap the initial admin (akadmin) on first start ---
# Applied only when the DB is empty (first migration). Change the password in the
# UI afterwards; the token is handy for API/terraform use.
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ vault_authentik_bootstrap_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ vault_authentik_bootstrap_token }}

# --- Avatars ---
# Resolve a user's avatar from attributes.picture (a URL or a data: URI set
# declaratively by roles/authentik_bootstrap), falling back to generated initials.
# This is what the OIDC `picture` claim carries -> Nextcloud pulls it as the
# profile photo (user_oidc --mapping-avatar=picture).
AUTHENTIK_AVATARS={{ authentik_avatars_mode | default('attributes.picture,initials') }}

# --- Behaviour ---
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

# --- SMTP (optional; for password-reset / notification emails) ---
AUTHENTIK_EMAIL__HOST={{ authentik_smtp_host }}
AUTHENTIK_EMAIL__PORT={{ authentik_smtp_port }}
AUTHENTIK_EMAIL__USERNAME={{ authentik_smtp_user }}
AUTHENTIK_EMAIL__PASSWORD={{ vault_authentik_smtp_password | default('') }}
AUTHENTIK_EMAIL__USE_TLS={{ authentik_smtp_use_tls | lower }}
AUTHENTIK_EMAIL__FROM={{ authentik_smtp_from }}
