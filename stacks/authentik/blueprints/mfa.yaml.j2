# Managed by Ansible — MFA enforcement for every interactive Authentik login.
#
# The default authentication flow already contains the stage
# `default-authentication-mfa-validation` (after the password), but it SKIPS users who have
# no authenticator. With authentik_mfa_enforce (default true) it becomes `configure`: a user
# without a second factor is walked through the setup on the next login (authenticator app /
# TOTP or passkey / security key / WebAuthn — their choice) and cannot finish the login
# without it; from then on the factor is asked on every login. Covers everything that logs
# in through Authentik: the native-OIDC apps (immich, nextcloud, grafana …) and forward-auth.
#
# NOT affected (by design):
#   - LDAP binds (WebDAV): they run the separate MFA-free `ldap-bind-flow` (ldap.yaml.j2) —
#     a headless bind cannot answer an MFA prompt.
#   - API tokens (the bootstrap token Ansible uses).
#   - Members of the `{{ authentik_mfa_exempt_group | default('mfa-exempt') }}` group: non-interactive logins that cannot hold a factor
#     (service accounts are put there by forward-auth.yaml.j2). Keep humans OUT of it.
#
# Lost factor / lock-out: an admin deletes the user's device (Directory -> Users -> the user
# -> MFA Authenticators), or on the host:
#   docker exec authentik-server ak create_recovery_key 10 <username>   # one-time login link
# Recovery codes ("static tokens") can be generated by each user in their settings afterwards.
version: 1
metadata:
  name: "ansible-mfa-enforcement"
entries:
{% if authentik_branding_title | default('') %}
  # Instance title: shown on the login page AND used as the issuer of TOTP entries, i.e. the
  # name an authenticator app displays ("<title>: <username>"). Naming the host makes the
  # entries of several instances distinguishable. Existing app entries keep their old name
  # (rename them in the app or re-enrol).
  - model: authentik_brands.brand
    identifiers:
      domain: authentik-default
    attrs:
      branding_title: "{{ authentik_branding_title }}"

{% endif %}
  - model: authentik_core.group
    id: mfa-exempt-group
    identifiers:
      name: "{{ authentik_mfa_exempt_group | default('mfa-exempt') }}"

  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    id: mfa-validation
    identifiers:
      name: default-authentication-mfa-validation
    attrs:
      not_configured_action: {{ 'configure' if (authentik_mfa_enforce | default(true) | bool) else 'skip' }}
      # what may be USED at login: app code, passkey/security key, recovery code
      device_classes: [totp, webauthn, static]
{% if authentik_mfa_enforce | default(true) | bool %}
      # what a user without a factor may SET UP (recovery codes alone are not offered)
      configuration_stages:
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]
        - !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, default-authenticator-webauthn-setup]]
{% endif %}

  # The existing binding of that stage in the default login flow (order 30) — declared here
  # only so the policy below can attach to it (!KeyOf resolves the binding target correctly).
  - model: authentik_flows.flowstagebinding
    id: mfa-binding
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !KeyOf mfa-validation
      order: 30
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true      # evaluated when the stage is reached: the user is known then
      # ALL policies must pass for the stage to run. Authentik ships a second policy on this
      # binding (skip MFA after a passwordless passkey login); with the default mode `any`
      # that one alone keeps the stage and the exemption below would never take effect.
      policy_engine_mode: all

  # False -> the MFA stage is skipped for this login.
  - model: authentik_policies_expression.expressionpolicy
    id: mfa-exempt-policy
    identifiers:
      name: ansible-mfa-skip-exempt
    attrs:
      expression: |
        # The flow hands the user who is logging in to the policy as request.user (the plan's
        # pending user); the context copy is only a fallback. Unknown/anonymous -> MFA applies.
        user = request.user or request.context.get("pending_user")
        if not user or not getattr(user, "pk", None):
            return True
        return not ak_is_group_member(user, name="{{ authentik_mfa_exempt_group | default('mfa-exempt') }}")

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf mfa-binding
      policy: !KeyOf mfa-exempt-policy
      order: 0
    attrs:
      enabled: true
      negate: false
      timeout: 30
