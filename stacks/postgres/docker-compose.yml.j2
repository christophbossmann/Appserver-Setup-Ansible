services:
  postgres:
    image: {{ postgres_image }}
    container_name: postgres
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ postgres_port }}:5432"
    volumes:
      - {{ postgres_data_dir }}:/var/lib/postgresql/data
{% if postgres_pitr_enabled | default(false) %}
      - {{ (postgres_pitr_instances | selectattr('name', 'equalto', 'postgres') | first).host_archive }}:/archive   # PITR: WAL archive + base backups (roles/postgres_pitr; @pg_archive subvolume)
{% endif %}
    environment:
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
      POSTGRES_DB: {{ postgres_db }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 60s
      timeout: 5s
      retries: 5

networks:
  default:
    name: backend
    external: true
