# Supabase .env — rendered by Ansible (compose_stack). Secrets come from the
# vault (vault_supabase_*); non-secret config from group_vars/all/supabase.yml.
# Do NOT edit on the host — change the template/vars and re-run the playbook.

############ Secrets ############
POSTGRES_PASSWORD={{ vault_supabase_postgres_password }}
JWT_SECRET={{ vault_supabase_jwt_secret }}
ANON_KEY={{ vault_supabase_anon_key }}
SERVICE_ROLE_KEY={{ vault_supabase_service_role_key }}

# Dashboard (Studio) basic-auth, enforced by Kong.
DASHBOARD_USERNAME={{ supabase_dashboard_username }}
DASHBOARD_PASSWORD={{ vault_supabase_dashboard_password }}

# Realtime + Supavisor comms (>=64 chars) / Studio<->meta / pooler vault.
SECRET_KEY_BASE={{ vault_supabase_secret_key_base }}
VAULT_ENC_KEY={{ vault_supabase_vault_enc_key }}
PG_META_CRYPTO_KEY={{ vault_supabase_pg_meta_crypto_key }}
REALTIME_DB_ENC_KEY={{ vault_supabase_realtime_enc_key }}

# Storage S3-protocol endpoint credentials (file backend still wants them set).
S3_PROTOCOL_ACCESS_KEY_ID={{ vault_supabase_s3_access_key_id }}
S3_PROTOCOL_ACCESS_KEY_SECRET={{ vault_supabase_s3_access_key_secret }}

############ URLs ############
SUPABASE_PUBLIC_URL={{ supabase_public_url }}
API_EXTERNAL_URL={{ supabase_public_url }}
SITE_URL={{ supabase_site_url }}
ADDITIONAL_REDIRECT_URLS={{ supabase_additional_redirect_urls }}

############ Database ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT={{ supabase_postgres_port }}

############ Supavisor (pooler) ############
# Host binds for the pooler are set in the compose (Jinja), not here — the
# container always listens on 5432/6543 internally.
POOLER_DEFAULT_POOL_SIZE={{ supabase_pooler_default_pool_size }}
POOLER_MAX_CLIENT_CONN={{ supabase_pooler_max_client_conn }}
POOLER_TENANT_ID={{ supabase_pooler_tenant_id }}
POOLER_DB_POOL_SIZE={{ supabase_pooler_db_pool_size }}

############ API gateway (Kong) ############
KONG_HTTP_PORT={{ supabase_kong_http_port }}
KONG_HTTPS_PORT=8443

############ PostgREST ############
PGRST_DB_SCHEMAS={{ supabase_pgrst_db_schemas }}
PGRST_DB_MAX_ROWS={{ supabase_pgrst_db_max_rows }}
PGRST_DB_EXTRA_SEARCH_PATH=public

############ Auth ############
JWT_EXPIRY={{ supabase_jwt_expiry }}
DISABLE_SIGNUP={{ supabase_disable_signup | lower }}
ENABLE_EMAIL_SIGNUP={{ supabase_enable_email_signup | lower }}
ENABLE_EMAIL_AUTOCONFIRM={{ supabase_enable_email_autoconfirm | lower }}
ENABLE_ANONYMOUS_USERS={{ supabase_enable_anonymous_users | lower }}
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# SMTP — fake by default (no outbound mail). Point at a real relay to enable.
SMTP_ADMIN_EMAIL={{ supabase_smtp_admin_email }}
SMTP_HOST={{ supabase_smtp_host }}
SMTP_PORT={{ supabase_smtp_port }}
SMTP_USER={{ supabase_smtp_user }}
SMTP_PASS={{ supabase_smtp_pass }}
SMTP_SENDER_NAME={{ supabase_smtp_sender_name }}

############ Studio ############
STUDIO_DEFAULT_ORGANIZATION={{ supabase_studio_org }}
STUDIO_DEFAULT_PROJECT={{ supabase_studio_project }}
OPENAI_API_KEY={{ supabase_openai_api_key }}

############ Storage ############
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

############ Functions ############
FUNCTIONS_VERIFY_JWT={{ supabase_functions_verify_jwt | lower }}

############ imgproxy ############
IMGPROXY_AUTO_WEBP=true
