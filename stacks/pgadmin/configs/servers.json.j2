{
  "Servers": {
    "1": {
      "Name": "Shared Postgres (n8n + immich)",
      "Group": "Homelab",
      "Host": "postgres",
      "Port": {{ postgres_port }},
      "MaintenanceDB": "{{ postgres_db }}",
      "Username": "{{ postgres_user }}",
      "SSLMode": "prefer",
      "Shared": true,
      "Comments": "Shared instance. '{{ postgres_user }}' is the superuser -> all databases (n8n, immich) visible. Password: vault_postgres_password."
    },
    "2": {
      "Name": "Authentik Postgres",
      "Group": "Homelab",
      "Host": "authentik-postgres",
      "Port": 5432,
      "MaintenanceDB": "authentik",
      "Username": "authentik",
      "SSLMode": "prefer",
      "Shared": true,
      "Comments": "Authentik's dedicated instance (isolated). Password: vault_authentik_postgres_password."
    },
    "3": {
      "Name": "Supabase Postgres",
      "Group": "Homelab",
      "Host": "supabase-db",
      "Port": 5432,
      "MaintenanceDB": "postgres",
      "Username": "supabase_admin",
      "SSLMode": "prefer",
      "Shared": true,
      "Comments": "Supabase's dedicated instance ('supabase_admin' is the superuser). Password: vault_supabase_postgres_password."
    }
  }
}
