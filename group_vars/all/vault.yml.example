---
# =============================================================================
# group_vars/all/vault.yml.example — TEMPLATE for vault.yml (safe to commit).
#
# Setup:
#   1. cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   2. Fill in real values (generate strong secrets, see hints per section).
#   3. Encrypt in place:  ansible-vault encrypt group_vars/all/vault.yml
#   4. Configure `vault_password_file` in ansible.cfg [defaults]
#      (or run playbooks with --ask-vault-pass).
#
# Convention: every secret is a vault_* variable; non-secret config references
# them via {{ vault_* }}. Find all consumers with:
#     grep -rn "vault_" group_vars host_vars roles stacks --include=*.yml
# =============================================================================

# --- Google Trust Services ACME EAB (one pair per environment) ---------------
# Create with: gcloud publicca external-account-keys create
# EAB keys expire after 7 days if not used to register an ACME account.
vault_gts_dev_eab_key_id: "CHANGEME-dev-key-id"
vault_gts_dev_eab_mac_key: "CHANGEME-dev-b64-mac-key"
vault_gts_prod_eab_key_id: "CHANGEME-prod-key-id"
vault_gts_prod_eab_mac_key: "CHANGEME-prod-b64-mac-key"

# --- Admin user (group_vars/all/users.yml sets the name; host_vars consume) ---
# Salt must be a FIXED random string (e.g. `openssl rand -hex 8`): a random
# salt per run would produce a new hash every time and make the users role
# permanently "changed".
vault_admin_user_password: "CHANGEME-strong-login-password"
vault_admin_user_salt: "CHANGEME-fixed-random-salt"

# --- Cloudflare (tunnel ingress model; see host_vars/myserver.yml) ------------
# API token: Cloudflare -> My Profile -> API Tokens -> Create custom token
#   permissions: Zone/DNS/Edit, Zone/Zone/Read, Account/Cloudflare Tunnel/Edit
# Connector token: Zero Trust -> Networks -> Tunnels -> Install connector
vault_cloudflare_api_token: "CHANGEME-cloudflare-api-token"
vault_cloudflared_tunnel_connector_token_myserver: "CHANGEME-tunnel-connector-token"

# --- Postgres / pgAdmin -------------------------------------------------------
vault_postgres_password: "CHANGEME"
vault_postgres_business_password: "CHANGEME"   # postgres-business instance (immich/nextcloud DBs)
vault_pgadmin_password: "CHANGEME"          # applied on FIRST START only

# --- Immich DB owner (unprivileged role, owns only the immich database) -------
# Immich restriction: use only A-Za-z0-9 (no special chars/spaces).
vault_immich_db_password: "CHANGEME"
# Break-glass password for the bootstrapped Immich admin (SSO is the real login).
vault_immich_admin_password: "CHANGEME"

# --- Immich Uploader (private repo, built on the server) -----------------------
# Fine-grained GitHub PAT, READ-ONLY "Contents" permission, scoped to ONLY the
# uploader repo.
vault_github_token_immich_uploader: "CHANGEME-github-fine-grained-pat"
# JWT signing secret for the uploader backend: openssl rand -hex 32
vault_immich_uploader_jwt_secret: "CHANGEME"

# --- Komodo -------------------------------------------------------------------
vault_komodo_passkey: "CHANGEME"            # Core<->Periphery trust secret: openssl rand -hex 32
vault_komodo_database_password: "CHANGEME"
vault_komodo_init_admin_password: "CHANGEME"  # applied on first start only

# --- Grafana ------------------------------------------------------------------
# Applied on FIRST START only; change later via:
#   docker exec grafana grafana-cli admin reset-admin-password NEW_PASSWORD
vault_grafana_admin_password: "CHANGEME"

# --- n8n ----------------------------------------------------------------------
vault_n8n_webdav_password: "CHANGEME"
# Strongly recommended for production (n8n credential encryption at rest);
# uncomment here AND n8n_encryption_key in group_vars/all/n8n.yml:
# vault_n8n_encryption_key: "CHANGEME-long-random-string"

# --- Claude Playground --------------------------------------------------------
vault_playground_webdav_password: "CHANGEME"

# --- Caddy basic_auth passwords (PLAINTEXT) -----------------------------------
# Store the plaintext; the bcrypt hash Caddy needs is DERIVED deterministically at
# render time with a fixed salt (caddy_basicauth_salt, roles/caddy/defaults/main.yml)
# -> idempotent, one source of truth per credential, no hash+plaintext drift.
vault_basicauth_playground: "CHANGEME"                       # shared playground password
vault_basicauth_webdav_playground: "{{ vault_basicauth_playground }}"   # point at the shared one; override for a distinct value
vault_basicauth_playwright: "{{ vault_basicauth_playground }}"
vault_basicauth_immich_share: "CHANGEME"                     # separate: handed out with immich share links

# Back-compat alias: Playwright's httpCredentials reads this name; derived from the
# single source above so the two can never drift.
vault_playground_basicauth_password: "{{ vault_basicauth_playground }}"
# --- Supabase -----------------------------------------------------------------
# Generate ALL of these with:  bash stacks/supabase/generate-keys.sh
# (prints ready-to-paste values). ANON_KEY/SERVICE_ROLE_KEY are HS256 JWTs
# signed with JWT_SECRET — regenerate them whenever vault_supabase_jwt_secret
# changes. Length rules: jwt_secret >=32, secret_key_base >=64,
# vault_enc_key ==32, realtime_enc_key ==16, pg_meta_crypto_key >=32.
vault_supabase_postgres_password: "CHANGEME"
vault_supabase_jwt_secret: "CHANGEME-at-least-32-characters-long-xx"
vault_supabase_anon_key: "CHANGEME-hs256-jwt"
vault_supabase_service_role_key: "CHANGEME-hs256-jwt"
vault_supabase_dashboard_password: "CHANGEME"
vault_supabase_secret_key_base: "CHANGEME-at-least-64-characters-long-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
vault_supabase_vault_enc_key: "CHANGEME-exactly-32-characters--"
vault_supabase_pg_meta_crypto_key: "CHANGEME-at-least-32-characters-xx"
vault_supabase_realtime_enc_key: "CHANGEME16charxx"
vault_supabase_s3_access_key_id: "CHANGEME"
vault_supabase_s3_access_key_secret: "CHANGEME"
# --- Authentik (IdP/SSO) ------------------------------------------------------
# Generate with:  bash stacks/authentik/generate-keys.sh
# secret_key: session/token signing — NEVER change on a live install.
vault_authentik_postgres_password: "CHANGEME"
vault_authentik_secret_key: "CHANGEME-long-random-base64"
vault_authentik_bootstrap_password: "CHANGEME"
vault_authentik_bootstrap_token: "CHANGEME-api-token"
# Optional SMTP relay password (leave as-is if no mail relay):
vault_authentik_smtp_password: ""

# OIDC client secrets — one per native-OIDC app (authentik_oauth_apps).
# Shared with the app's own OIDC config. Generate: openssl rand -hex 32
vault_authentik_oauth_grafana_secret: "CHANGEME"
vault_authentik_oauth_immich_secret: "CHANGEME"
vault_authentik_oauth_komodo_secret: "CHANGEME"
vault_authentik_oauth_pgadmin_secret: "CHANGEME"
vault_authentik_oauth_headplane_secret: "CHANGEME"

# Service-account passwords (set via API by roles/authentik_bootstrap).
vault_authentik_playwright_password: "CHANGEME"

# Human-user passwords (INITIAL-ONLY — applied only on a fresh install). One per
# entry in authentik_users that declares a password.
vault_authentik_user_alice_password: "CHANGEME"
vault_authentik_user_other_password: "CHANGEME"   # shared initial password for the other declared users

# --- Nextcloud ----------------------------------------------------------------
vault_nextcloud_db_password: "CHANGEME"
vault_nextcloud_admin_password: "CHANGEME"        # first install only
vault_authentik_oauth_nextcloud_secret: "CHANGEME"  # openssl rand -hex 32
vault_maptiler_key: ""                            # optional: Nextcloud Maps tiles via MapTiler (OSM default is blocked); empty = leave Maps as-is

# --- Cloud backup (restic over rclone) -----------------------------------------
vault_restic_password: "CHANGEME"   # repo encryption key — keep a copy OFF-host!
vault_rclone_backup_conf: ""        # full [cloudbackup] rclone remote section (see vault.yml docs)

# --- Self-hosted acme-dns (roles/acme_dns): API passwords of the declarative accounts
# Generate: openssl rand -hex 20
vault_acme_dns_dev_password: "CHANGEME"
vault_acme_dns_int_password: "CHANGEME"
# ZeroSSL API key (optional CA fallback; empty = unused)
vault_zerossl_api_key: ""

# --- Storage Box SSH private key (public key goes in the Hetzner panel) --------
# Multi-line PEM:  vault_storagebox_ssh_private_key: |
#                    -----BEGIN OPENSSH PRIVATE KEY-----
#                    ...
vault_storagebox_ssh_private_key: ""
