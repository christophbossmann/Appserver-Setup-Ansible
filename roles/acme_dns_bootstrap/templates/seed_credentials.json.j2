{
{% for a in acme_dns_accounts %}
  "{{ a.cert_domain }}": {
    "username": "{{ a.username }}",
    "password": "{{ a.password }}",
    "subdomain": "{{ a.subdomain }}",
    "fulldomain": "{{ a.subdomain }}.{{ acme_dns_domain }}",
    "server_url": "http://127.0.0.1:{{ acme_dns_api_port }}",
    "allowfrom": []
  }{% if not loop.last %},{% endif %}

{% endfor %}
}
