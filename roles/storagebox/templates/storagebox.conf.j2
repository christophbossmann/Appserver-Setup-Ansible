# rclone config for the Storage Box mount — managed by the storagebox role.
# Separate from backup_restic's rclone.conf so the two never clobber each other.
[{{ storagebox_remote_name }}]
type = sftp
host = {{ storagebox_host }}
user = {{ storagebox_user }}
port = {{ storagebox_port }}
key_file = {{ storagebox_key_file }}
shell_type = unix
# Hetzner Storage Box provides these checksum helpers; lets rclone verify without reading.
md5sum_command = md5 -r
sha1sum_command = sha1 -r
{% for c in storagebox_crypt_remotes | default([]) %}

# Encrypted folder on the box (contents encrypted, names readable: *.bin). The two passwords
# live in the vault (+ a second safe place) — without BOTH the data is lost.
[{{ c.name }}]
type = crypt
remote = {{ storagebox_remote_name }}:{{ c.path }}
filename_encryption = {{ c.filename_encryption | default('off') }}
directory_name_encryption = {{ c.directory_name_encryption | default('false') }}
password = {{ _sb_crypt_obscured[c.name].password }}
password2 = {{ _sb_crypt_obscured[c.name].password2 }}
{% endfor %}
