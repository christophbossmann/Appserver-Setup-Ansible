                             "cls": "wide"})
    return 0


def cmd_block(action, net, comment=""):
    if action not in ("add", "remove") or not SAFE_NET.match(net) or not SAFE_COMMENT.match(comment):
        print(json.dumps({"status": "refused", "reason": "invalid request"}))
        return 1
    if not os.path.exists(BLOCKLIST):
        print(json.dumps({"status": "refused", "reason": "the blocklist is not enabled on this host"}))
        return 1
    args = [BLOCKLIST, "add", net, comment, requester()] if action == "add" else [BLOCKLIST, "remove", net, requester()]
    r = subprocess.run(args, capture_output=True, text=True)
    out = (r.stdout.strip().splitlines() or [""])[-1]
    print(out if out.startswith("{") else json.dumps({"status": "refused", "reason": (r.stderr or out).strip()[:300]}))
    return r.returncode


def main(argv):
    if len(argv) == 4 and argv[1] == "request":
        return cmd_request(argv[2], argv[3])
    if len(argv) == 3 and argv[1] == "run":
        return cmd_run(argv[2])
    if len(argv) == 2 and argv[1] == "status":
        return cmd_status()
    if len(argv) == 2 and argv[1] == "expire":
        return cmd_expire()
    if len(argv) in (3, 4) and argv[1] == "log":
        return cmd_log(argv[2], (argv[3:] + [""])[0])
    if len(argv) in (2, 3) and argv[1] == "logpage":
        return cmd_logpage((argv[2:] + [""])[0])
    if len(argv) == 2 and argv[1] == "blockpage":
        return cmd_blockpage()
    if len(argv) in (4, 5) and argv[1] == "block":
        return cmd_block(*argv[2:5])
    if len(argv) in (2, 3, 4) and argv[1] == "page":
        return cmd_page(*(argv[2:] + ["", ""])[:2])
    print("usage: app-upgrade request <service> <version> | run <service>:<version> | status | "
          "page [<service|image> <version>] | logpage <service> | log <service> [<cursor>]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
