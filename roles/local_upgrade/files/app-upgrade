BLOCKLIST = "/usr/local/sbin/blocklist"
SAFE_NET = re.compile(r"^[0-9A-Fa-f:.]{2,45}(/[0-9]{1,3})?$")
SAFE_COMMENT = re.compile(r"^[A-Za-z0-9 ._:/@+,()#-]{0,120}$")
BLOCKSCRIPT = """<script>
const bo = document.getElementById('bout');
async function change(action, net, comment) {
  bo.className = ''; bo.textContent = (action === 'add' ? 'Blocking ' : 'Removing ') + net + ' …';
  try {
    const r = await fetch('/hooks/blocklist-change', {method: 'POST', headers: {'Content-Type': 'application/json'},
                                                     body: JSON.stringify({action: action, net: net, comment: comment || ''})});
    const a = JSON.parse((await r.text()).trim().split('\\n').pop());
    if (a.status === 'ok') { bo.className = 'ok'; bo.textContent = net + ': ' + a.note + ' — reloading…'; setTimeout(() => location.reload(), 900); }
    else { bo.className = 'bad'; bo.textContent = 'Refused: ' + (a.reason || 'unknown answer'); }
  } catch (e) { bo.className = 'bad'; bo.textContent = 'Request failed (check the address format): ' + e; }
}
document.getElementById('badd').addEventListener('click', () =>
  change('add', document.getElementById('bnet').value.trim(), document.getElementById('bcom').value.trim()));
document.querySelectorAll('button[data-remove]').forEach(b => b.addEventListener('click', () => {
  if (confirm('Remove ' + b.dataset.remove + ' from the blocklist?')) change('remove', b.dataset.remove, '');
}));
</script>"""


