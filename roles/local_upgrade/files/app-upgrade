    out.textContent = 'Started.'; setTimeout(poll, 3000); setTimeout(() => follow(svc), 3000);
  } catch (e) { out.className = 'bad'; out.textContent = 'Request failed: ' + e; go.disabled = false; }
});
</script>"""


def esc(value):
    return html.escape(str(value), quote=True)


def resolve(what, cat):
    """Service name for a service name or an image reference (what a dashboard row links with)."""
    if what in cat:
        return what
    repo = what.rsplit(":", 1)[0] if ":" in what.rsplit("/", 1)[-1] else what
    for name, svc in cat.items():
        if repo in svc["images"]:
            return name
    return None


def findings(svc, version):
    """{severity: (now, after)} summed over the service's images; after = None if not scanned."""
    out = {}
    for sev in ("CRITICAL", "HIGH"):
        now = sum(v for lbl, v in prom("trivy_image_vulnerabilities")
                  if lbl.get("severity") == sev and lbl.get("image", "").rsplit(":", 1)[0] in svc["images"])
        after = [v for lbl, v in prom("trivy_image_newer_vulnerabilities")
                 if lbl.get("severity") == sev and lbl.get("version") == version
                 and lbl.get("image", "").rsplit(":", 1)[0] in svc["images"]]
        out[sev] = (int(now), int(sum(after)) if after else None)
    return out


def rollback_link(name, recs):
    rec = rollback_valid(name, recs)
    if not rec:
        return ""
    return (' · <a href="/hooks/upgrade?image=%s&amp;version=rollback">roll back to <code>%s</code></a> '
            '<span class="muted">(until %s)</span>' % (esc(name), esc(rec["from"].rsplit(":", 1)[-1]),
                                                       time.strftime("%a %H:%M", time.localtime(rec["expires"]))))


def last_line(name, state):
    r = state.get(name)
    if not r:
        return '<span class="muted">never upgraded here</span>'
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(r["finished"]))
    host = r.get("target") in ("host", "snapshots", "rollback")
    return '<span class="%s">%s</span> %s <code>%s</code> on %s (by %s) · <a href="/hooks/upgrade-log?service=%s">log</a>' % (
        "ok" if r["ok"] else "bad", ("done" if host else "upgraded") if r["ok"] else ("FAILED" if host else "FAILED / rolled back"),
        ":" if host else "to", esc(r["version"]), when,
        esc(r.get("by", "local")), esc(name))


def no_targets(svc, scanning):
    """Why the overview offers no upgrade: really up to date, or just not compared (yet)?"""
    running = running_images(svc)
    compared = {lbl.get("image") for lbl, v in prom("trivy_image_newer_check_success") if v == 1}
    if running and all(i in compared for i in running):
        return '<span class="muted">up to date</span>'
    if scanning:
        return '<span class="warn">checking for newer versions… (scan running, reload in a few minutes)</span>'
    return '<span class="muted">not compared with the registry yet (next scan)</span>'


def page_index(cat, state):
    rows, run = [], current_run()
    scanning = bool(unit_active("trivy-metrics.service"))
    recs = rollback_records()
    for name, svc in sorted(cat.items(), key=lambda kv: (kv[1].get("kind") != "host", kv[0])):
        if not svc.get("local") or svc.get("kind") == "snapshots":
            continue
        if svc.get("kind") == "host":
            pending, reboot = host_state()
            links = " · ".join('<a href="/hooks/upgrade?image=%s&amp;version=%s">%s</a>' % (esc(name), esc(m), esc(m))
                               for m in HOST_MODES)
            rows.append("<tr><td><b>server</b></td><td><code>kernel %s</code><br>%s%s</td><td>%s</td><td>%s</td></tr>" % (
                esc(os.uname().release), "%d package(s) pending" % len(pending) if pending else "packages up to date",
                '<br><b class="warn">restart required</b>' if reboot else "", links,
                '<b class="warn">running: %s</b> · <a href="/hooks/upgrade-log?service=%s">follow the log</a>'
                % (esc(run["version"]), esc(name)) if run and run.get("service") == name else last_line(name, state)))
            continue
        tags = ", ".join(sorted({i.rsplit(":", 1)[-1] for i in running_images(svc)})) or "–"
        links = ", ".join('<a href="/hooks/upgrade?image=%s&amp;version=%s">%s</a> <span class="muted">(%s)</span>'
                          % (esc(name), esc(v), esc(v), esc(KIND.get(k, k)))
                          for v, k in sorted(targets(svc).items(), key=lambda t: list(KIND).index(t[1]) if t[1] in KIND else 9))
        rows.append("<tr><td>%s</td><td><code>%s</code></td><td>%s</td><td>%s</td></tr>"
                    % (esc(name), esc(tags), links or no_targets(svc, scanning),
                       '<b class="warn">running: %s</b> · <a href="/hooks/upgrade-log?service=%s">follow the log</a>'
                       % (esc(run["version"]), esc(name)) if run and run.get("service") == name
                       else last_line(name, state) + rollback_link(name, recs)))
    other = sorted(n for n, s in cat.items() if not s.get("local") and s.get("kind", "image") == "image")
    last = max((v for _, v in prom("trivy_scan_timestamp_seconds")), default=0)
    age = int(time.time() - last) if last else None
    scan = ('<p><button id=scan%s>Scan now</button> <span id=sstate class=muted>%s</span></p>' % (
        " disabled" if scanning else "",
        "scan running — reload in a few minutes" if scanning else
        "never scanned yet" if age is None else
        "last scan %s ago (nightly; registry tag lists are reused for 12 h — Docker Hub limits)" % (
            "%d min" % (age // 60) if age < 7200 else "%d h" % (age // 3600))))
    return ("<h1>On-host upgrades</h1>" + scan + "<div class=card><table><tr><th>Service</th><th>Running</th><th>Upgrade to</th>"
            "<th>Last upgrade</th></tr>%s</table></div><p class=muted>Versions come from the nightly registry "
            "comparison (Grafana → Vulnerabilities). Only from the laptop: %s.</p>" % ("".join(rows), esc(", ".join(other))))


def page_host(name, version, state):
    pending, reboot = host_state()
    reason = ""
    try:
        svc, _ = validate(name, version)
        prechecks(svc)
    except Refused as e:
        reason = str(e)
    restarts = sorted({p.split()[0] for p in pending} & {"docker-ce", "containerd.io"})
    rows = [("Action", "<b>%s</b> — %s" % (esc(version), esc(HOST_MODES.get(version, "?")))),
            ("Running", "<code>kernel %s</code>, restart required: <b>%s</b>" % (esc(os.uname().release), "yes" if reboot else "no"))]
    if version != "reboot":
        rows.append(("Packages", ("%d pending (as of apt's last list refresh; refreshed again before the upgrade):<br>" % len(pending)
                                  + "<br>".join("<code>%s</code>" % esc(p) for p in pending[:60])
                                  + ("<br>… and %d more" % (len(pending) - 60) if len(pending) > 60 else ""))
                     if pending else "none pending"))
        rows.append(("Effect", ('<span class="warn">%s is upgraded: the Docker daemon restarts and with it EVERY container — everything '
                                "is unreachable for about a minute, this page too (reload it afterwards).</span>" % esc(" + ".join(restarts)))
                     if restarts else "no Docker upgrade pending — containers keep running"))
        rows.append(("Caddy", "the newest release is built with the same plugins; it replaces the running one only if it "
                              "accepts the live configuration, and the previous one is put back if it does not come up"))
    if version != "packages":
        rows.append(("Restart", '<span class="warn">The server restarts %s. Everything is down for a few minutes.</span>'
                     % ("one minute after you confirm" if version == "reboot"
                        else "one minute after the upgrade — only if a restart is required then")))
    rows.append(("Safety net", "a snapshot pair of the root filesystem frames the run (normal retention); "
                               "to go back: <code>snapper -c root list</code> / rollback from the laptop"))
    rows.append(("Last run", last_line(name, state)))
    body = "<h1>Server: %s?</h1><div class=card><table>%s</table></div>" % (
        esc(version), "".join("<tr><th>%s</th><td>%s</td></tr>" % r for r in rows))
    if reason:
        body += '<div class=card><b class="bad">Not possible right now:</b> %s</div>' % esc(reason)
    body += ('<button id=go data-service="%s" data-version="%s"%s>%s</button><div id=out></div><div id=log></div>'
             % (esc(name), esc(version), " disabled" if reason else "",
                "Restart now" if version == "reboot" else "Upgrade now"))
    return body


LOSS = {
    "postgres-business": "the Immich AND Nextcloud databases go back to that moment (they share the instance), and so "
                         "do their data volumes (snapshots taken at that moment). Photos uploaded to Immich since then "
                         "are imported again afterwards (they stay, albums / favourites / faces set since then do not). "
