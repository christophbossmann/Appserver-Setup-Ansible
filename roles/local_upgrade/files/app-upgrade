}


def page_rollback(name, state):
    recs = rollback_records()
    rec = rollback_valid(name, recs)
    reason = ""
    try:
        svc, _ = validate(name, "rollback")
        prechecks(svc)
    except Refused as e:
        reason = str(e)
    if not rec:
        return '<h1>Roll back %s?</h1><div class=card><b class="bad">Not possible:</b> %s</div>' % (esc(name), esc(reason))
    joint = rollback_joint(rec, recs)
    tag = lambda v: v.rsplit(":", 1)[-1]
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["created"]))
    rows = [("Roll back", "<b>%s</b>: <code>%s</code> → <code>%s</code>" % (esc(name), esc(tag(rec["to"])), esc(tag(rec["from"])))),
            ("Upgraded", "%s · possible until %s" % (when, time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["expires"]))))]
    if len(joint) > 1:
        rows.append(("Goes back too", '<span class="warn">%s — upgraded after it on the same database instance; its new '
                                      "version would not work on the old database</span>"
                     % esc(", ".join("%s %s → %s" % (r["service"], tag(r["to"]), tag(r["from"])) for r in joint[1:]))))
    if rec.get("anchor"):
        rows.append(("Data", '<span class="warn">%s</span>' % esc(LOSS.get(rec.get("pitr"), "the database goes back to that moment."))))
        rows.append(("Point in time", "<code>%s</code>%s" % (esc(rec["anchor"]), (" · volumes: " + esc(", ".join(
            "%s #%s" % kv for kv in rec.get("snapshots", {}).items()))) if rec.get("snapshots") else "")))
    else:
        rows.append(("Data", "the previous image" + (" and the state copy taken right before the upgrade (changes since are lost)"
                                                     if rec.get("state_paths") else "; no database of its own")))
    rows.append(("First", "the images of the previous versions are downloaded — if that fails, nothing is changed"))
    body = "<h1>Roll back %s?</h1><div class=card><table>%s</table></div>" % (
        esc(name), "".join("<tr><th>%s</th><td>%s</td></tr>" % r for r in rows))
    if reason:
        body += '<div class=card><b class="bad">Not possible right now:</b> %s</div>' % esc(reason)
    else:
        body += ('<p>Type <code>%s rollback</code> to confirm: <input id=confirm data-expect="%s rollback" autocomplete=off '
                 'style="font:inherit;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink)"></p>'
                 % (esc(name), esc(name)))
    body += ('<button id=go data-service="%s" data-version="rollback"%s>Roll back now</button><div id=out></div><div id=log></div>'
             % (esc(name), " disabled data-blocked=1" if reason else ""))
    return body


def page_confirm(name, version, cat, state):
    svc = cat[name]
    if version == "rollback":
        return page_rollback(name, state)
    if svc.get("kind") == "host":
        return page_host(name, version, state)
    reason, target = "", ""
    try:
        svc, target = validate(name, version)
        prechecks(svc)
    except Refused as e:
        reason = str(e)
    rows = [("Service", "<b>%s</b>" % esc(name)),
            ("Running", "<br>".join("<code>%s</code>" % esc(i) for i in running_images(svc)) or "–"),
            ("Upgrade to", "<code>%s</code> %s" % (esc(version), '<span class="muted">(%s)</span>' % esc(KIND.get(target, target))
                                                    if target else ""))]
    if target:
        f = findings(svc, version)
        rows.append(("Findings", " · ".join("%s %d → %s" % (sev.capitalize(), now, "?" if after is None else after)
                                             for sev, (now, after) in f.items())
                     + ' <span class="muted">(now → in the new version, as scanned)</span>'))
    rows.append(("If it fails", "the database is rolled back to the restore point set right before the upgrade (PITR, "
                 "instance <code>%s</code>) and the old images are started again" % esc(svc["pitr"]) if svc.get("pitr")
                 else "the previous image is started again (no database of its own)"))
    rows.append(("Last upgrade", last_line(name, state)))
    if target == "latest":
        rows.append(("Note", '<span class="warn">This is the newest major version — it may skip major versions in '
                             'between. Check the application\'s upgrade path first.</span>'))
    body = "<h1>Upgrade %s to %s?</h1><div class=card><table>%s</table></div>" % (
        esc(name), esc(version), "".join("<tr><th>%s</th><td>%s</td></tr>" % r for r in rows))
    if reason:
        body += '<div class=card><b class="bad">Not possible right now:</b> %s</div>' % esc(reason)
    body += ('<button id=go data-service="%s" data-version="%s"%s>Upgrade now</button><div id=out></div><div id=log></div>'
             % (esc(name), esc(version), " disabled" if reason else ""))
    return body


def cmd_page(what, version):
    cat, state = catalog(), load_state()
    name = resolve(what, cat) if what else None
    script = ""
    if not what:
        title, body, script = "On-host upgrades", page_index(cat, state), SCANSCRIPT
    elif not name:
        title = "Unknown service"
        body = '<h1>Unknown service</h1><div class=card>No upgradable service runs <code>%s</code>.</div>' % esc(what)
    elif cat[name].get("kind") == "snapshots":
        if not cat[name].get("local"):
            title, body = "Snapshots", "<h1>Snapshots</h1><div class=card>Not enabled on this host.</div>"
        elif version:
            title, body, script = "Snapshots", page_snap_confirm(version, state), FOLLOW + SCRIPT + SNAPSCRIPT
        else:
            title, body, script = "Snapshots", page_snapshots(state), MEASURESCRIPT
    else:
        title, body, script = "Upgrade %s" % name, page_confirm(name, version, cat, state), FOLLOW + SCRIPT + SNAPSCRIPT
    wide = bool(name) and cat[name].get("kind") == "snapshots" and not version
    sys.stdout.write(PAGE % {"title": esc(title), "host": esc(os.uname().nodename), "user": esc(requester()),
                             "body": body, "script": script, "cls": "wide" if wide else ""})
    return 0


