#!/usr/bin/env python3
# Managed by Ansible (roles/hardening). Spamhaus DROP -> ipsets referenced by UFW rules.
#
#   spamhaus-drop restore   create the ipsets (empty if needed) and load the last saved
#                           list — runs BEFORE ufw at boot (spamhaus-ipset.service), so the
#                           UFW rules that reference the sets can always load
#   spamhaus-drop update    download the current lists, sanity-check, atomically swap them
#                           into the live sets, save for the next boot (daily timer)
#
# Sets: spamhaus-drop4 (hash:net inet), spamhaus-drop6 (hash:net inet6). The DROP rules
# themselves live in UFW's rule files (before.rules / before6.rules / after.rules
# DOCKER-USER) — this script never touches iptables. A failed or suspiciously small
# download leaves the current sets untouched.
import json, os, subprocess, sys, time, urllib.request

LISTS = {
    "spamhaus-drop4": ("inet", "https://www.spamhaus.org/drop/drop_v4.json"),
    "spamhaus-drop6": ("inet6", "https://www.spamhaus.org/drop/drop_v6.json"),
}
STATE_DIR = "/var/lib/spamhaus-drop"
METRICS = "/var/lib/node_exporter/textfile/spamhaus.prom"
MIN_V4 = int(os.environ.get("SPAMHAUS_MIN_V4", "300"))


def ipset(*args, stdin=None):
    return subprocess.run(["ipset", *args], input=stdin, text=True, capture_output=True)


def ensure_set(name, family):
    ipset("create", name, "hash:net", "family", family, "maxelem", "131072", "-exist")


def load(name, family, cidrs):
    """Fill a temp set and swap it with the live one (atomic for the firewall)."""
    tmp = name + "-tmp"
    ipset("destroy", tmp)
    lines = [f"create {tmp} hash:net family {family} maxelem 131072"]
    lines += [f"add {tmp} {c} -exist" for c in cidrs]
    r = ipset("restore", stdin="\n".join(lines) + "\n")
    if r.returncode != 0:
        ipset("destroy", tmp)
        raise RuntimeError(f"ipset restore {tmp}: {r.stderr.strip()}")
    ensure_set(name, family)
    ipset("swap", tmp, name)
    ipset("destroy", tmp)


def saved(name):
    return os.path.join(STATE_DIR, name + ".txt")


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "spamhaus-drop (ansible roles/hardening)"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read().decode()
    cidrs = []
    for line in body.splitlines():
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if "cidr" in obj:
            cidrs.append(obj["cidr"])
    return cidrs


def write_metrics(counts):
    if not os.path.isdir(os.path.dirname(METRICS)):
        return
    out = ["# HELP spamhaus_drop_entries Networks in the Spamhaus DROP ipset",
           "# TYPE spamhaus_drop_entries gauge"]
    out += [f'spamhaus_drop_entries{{set="{n}"}} {c}' for n, c in counts.items()]
    out += ["# HELP spamhaus_drop_last_update_timestamp_seconds Last successful list refresh",
            "# TYPE spamhaus_drop_last_update_timestamp_seconds gauge",
            f"spamhaus_drop_last_update_timestamp_seconds {int(time.time())}"]
    with open(METRICS + ".tmp", "w") as f:
        f.write("\n".join(out) + "\n")
    os.chmod(METRICS + ".tmp", 0o644)
    os.replace(METRICS + ".tmp", METRICS)


def restore():
    for name, (family, _) in LISTS.items():
        ensure_set(name, family)
        if os.path.exists(saved(name)):
            cidrs = [l.strip() for l in open(saved(name)) if l.strip()]
            load(name, family, cidrs)
            print(f"{name}: restored {len(cidrs)} networks")
        else:
            print(f"{name}: created empty (no saved list yet)")


def update():
    os.makedirs(STATE_DIR, exist_ok=True)
    results = {}
    for name, (family, url) in LISTS.items():
        cidrs = fetch(url)                       # raises on HTTP/network errors -> keep old
        floor = MIN_V4 if family == "inet" else 1
        if len(cidrs) < floor:
            raise RuntimeError(f"{name}: only {len(cidrs)} entries from {url} (< {floor}) - keeping current list")
        results[name] = (family, cidrs)
    for name, (family, cidrs) in results.items():   # swap only after BOTH lists checked out
        load(name, family, cidrs)
        with open(saved(name) + ".tmp", "w") as f:
            f.write("\n".join(cidrs) + "\n")
        os.replace(saved(name) + ".tmp", saved(name))
        print(f"{name}: {len(cidrs)} networks")
    write_metrics({n: len(c) for n, (_, c) in results.items()})


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "restore":
        restore()
    elif mode == "update":
        update()
    else:
        sys.exit("usage: spamhaus-drop restore|update")
