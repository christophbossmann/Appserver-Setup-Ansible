{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "What inside the filesystems takes the space: hourly du of /srv, /opt, docker, logs, home and the Storage Box (roles/monitoring: monitoring_disk_usage_paths).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 1,
      "title": "Local disk - where the space goes",
      "type": "marcusolsson-treemap-panel",
      "description": "Directory sizes on the server's own disk (du, hourly), grouped by measured root. .snapshots excluded (btrfs snapshots share extents). Boxes < 1 MB hidden.",
      "gridPos": {
        "h": 16,
        "w": 11,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textField": "path",
        "sizeField": "Value",
        "colorField": "Value",
        "groupByField": "root",
        "tiling": "treemapSquarify"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "disk_usage_bytes{root!=\"/mnt/storagebox\"} > 1e6",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 6,
      "title": "Storage Box - where the space goes",
      "type": "marcusolsson-treemap-panel",
      "description": "Directory sizes on the Storage Box mount (immich originals per host).",
      "gridPos": {
        "h": 16,
        "w": 5,
        "x": 11,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textField": "path",
        "sizeField": "Value",
        "colorField": "Value",
        "groupByField": "root",
        "tiling": "treemapSquarify"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "disk_usage_bytes{root=\"/mnt/storagebox\"} > 1e6",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "title": "Filesystems",
      "type": "bargauge",
      "description": "Used share of each filesystem (root disk and the Storage Box mount).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "namePlacement": "top",
        "showUnfilled": true,
        "valueMode": "text",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/storagebox\"} / node_filesystem_size_bytes{mountpoint=~\"/|/mnt/storagebox\"}",
          "refId": "A",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3,
      "title": "Free space",
      "type": "stat",
      "description": "Absolute free space per filesystem.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/storagebox\"}",
          "refId": "A",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The 15 largest measured directories.",
      "id": 4,
      "title": "Largest directories",
      "type": "bargauge",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "namePlacement": "top",
        "showUnfilled": true,
        "valueMode": "text",
        "sizing": "manual",
        "minVizHeight": 30,
        "maxVizHeight": 34,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(15, disk_usage_bytes))",
          "refId": "A",
          "legendFormat": "{{path}}",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How the 8 currently largest directories developed over time.",
      "id": 5,
      "title": "Growth of the largest directories",
      "type": "timeseries",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "interval": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "barAlignment": 0,
            "showPoints": "never",
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "disk_usage_bytes and on (path) topk(8, disk_usage_bytes)",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ]
    }
  ],
