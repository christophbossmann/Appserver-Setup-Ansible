{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "What inside the filesystems takes the space: hourly du of /srv, /opt, docker, logs, home and the Storage Box (roles/monitoring: monitoring_disk_usage_paths).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 1,
      "title": "Local disk - where the space goes",
      "type": "marcusolsson-treemap-panel",
      "description": "Directory sizes on the server's own disk (du, hourly), grouped by measured root. .snapshots excluded (btrfs snapshots share extents). Boxes < 1 MB hidden.",
      "gridPos": {
        "h": 16,
        "w": 11,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textField": "path",
        "sizeField": "Value",
        "colorField": "Value",
        "groupByField": "root",
        "tiling": "treemapSquarify"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "disk_usage_bytes{root!=\"/mnt/storagebox\"} > 1e6",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 6,
      "title": "Storage Box - where the space goes",
      "type": "marcusolsson-treemap-panel",
      "description": "Directory sizes on the Storage Box mount (immich originals per host).",
      "gridPos": {
        "h": 16,
        "w": 5,
        "x": 11,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textField": "path",
        "sizeField": "Value",
        "colorField": "Value",
        "groupByField": "root",
        "tiling": "treemapSquarify"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "disk_usage_bytes{root=\"/mnt/storagebox\"} > 1e6",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "title": "Filesystems",
      "type": "bargauge",
      "description": "Used share of each filesystem (root disk and the Storage Box mount).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "namePlacement": "top",
        "showUnfilled": true,
        "valueMode": "text",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/storagebox\"} / node_filesystem_size_bytes{mountpoint=~\"/|/mnt/storagebox\"}",
          "refId": "A",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3,
      "title": "Filesystems: total, used, free",
      "type": "table",
      "description": "Size, used and free space of the local disk (/) and the Storage Box. Local 'used' includes what snapshots still hold (see the Disk snapshots dashboard) and the container images (/var/lib/containerd).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.75
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Filesystem"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "max by (mountpoint) (node_filesystem_size_bytes{mountpoint=~\"/|/mnt/storagebox\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "max by (mountpoint) (node_filesystem_size_bytes{mountpoint=~\"/|/mnt/storagebox\"} - node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/storagebox\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "max by (mountpoint) (node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/storagebox\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "format": "table",
          "instant": true,
          "expr": "max by (mountpoint) (1 - node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/storagebox\"} / node_filesystem_size_bytes{mountpoint=~\"/|/mnt/storagebox\"})"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "mountpoint",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "mountpoint": "Filesystem",
              "Value #A": "Total",
              "Value #B": "Used",
              "Value #C": "Free",
              "Value #D": "Used %"
            },
            "indexByName": {
              "mountpoint": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The 15 largest measured directories.",
      "id": 4,
      "title": "Largest directories",
      "type": "bargauge",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "namePlacement": "top",
        "showUnfilled": true,
        "valueMode": "text",
        "sizing": "manual",
        "minVizHeight": 30,
        "maxVizHeight": 34,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(15, disk_usage_bytes))",
          "refId": "A",
          "legendFormat": "{{path}}",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How the 8 currently largest directories developed over time.",
      "id": 5,
      "title": "Growth of the largest directories",
      "type": "timeseries",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "interval": "",
      "fieldConfig": {
        "defaults": {
