          },
          "expr": "disk_usage_bytes and on (path) topk(8, disk_usage_bytes)",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Largest directories anywhere (nightly search)",
      "description": "Found by walking every local filesystem completely once a night (disk-discover-metrics) \u2014 not limited to the fixed list the panels above use, so data in an unexpected place shows up here. Every directory of at least the threshold, split as deep as it stays that big; nothing is counted twice. '(rest)' = what a directory holds besides its big children, '(everything smaller)' = the remainder of a volume. Snapshot directories and the Storage Box are left out.",
      "gridPos": {
        "h": 18,
        "w": 16,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "namePlacement": "left",
        "showUnfilled": true,
        "valueMode": "text",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 22,
        "text": {
          "titleSize": 12,
          "valueSize": 12
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "legendFormat": "{{path}}",
          "expr": "sort_desc(topk(30, disk_big_dir_bytes))"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Not attributed",
      "description": "Used space the nightly search could not explain: used - all directories it measured - what only snapshots still hold. A few GiB are normal (filesystem metadata, estimates). A large value means data somewhere that is not visible as files \u2014 or a place the search does not reach.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8000000000.0
              },
              {
                "color": "red",
                "value": 20000000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "expr": "sum(disk_discover_unassigned_bytes)"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Used = files + snapshots + not attributed",
      "description": "How the used space of the local disk adds up: what the search found as files, what only snapshots still hold (Disk snapshots dashboard), and the unexplained remainder.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
