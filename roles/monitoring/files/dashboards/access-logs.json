      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host": true
            },
            "indexByName": {
              "Value": 0,
              "ip": 1,
              "method": 2,
              "path": 3,
              "status": 4
            }
          }
        }
      ]
