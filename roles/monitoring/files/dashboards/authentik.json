    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per hour: password submissions vs. completed logins. A gap between the two = wrong passwords (or abandoned MFA).",
      "id": 5,
      "title": "Login attempts vs. completed logins",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": 0,
            "showPoints": "never",
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(authentik_flows_execution_stage_time_count{stage_type=~\".*PasswordStageView\",method=\"POST\"}[1h]))",
          "refId": "A",
          "legendFormat": "password submissions"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(authentik_flows_execution_stage_time_count{stage_type=~\".*UserLoginStageView\"}[1h]))",
          "refId": "B",
          "legendFormat": "completed logins"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Requests handled by Authentik, by destination (core API/UI vs. embedded outpost / forward-auth).",
      "id": 6,
      "title": "Requests per second",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "interval": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "barAlignment": 0,
            "showPoints": "never",
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (dest) (rate(authentik_main_request_duration_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "{{dest}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "95th percentile request duration, by destination.",
      "id": 7,
      "title": "Request latency p95",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "interval": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "barAlignment": 0,
            "showPoints": "never",
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (dest, le) (rate(authentik_main_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{dest}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Executions per flow stage per hour (identification, password, MFA, login).",
      "id": 8,
